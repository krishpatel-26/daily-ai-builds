{
  "openapi": "3.0.3",
  "info": {
    "title": "Demo Commerce API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://api.production.internal"
    }
  ],
  "paths": {
    "/profile": {
      "get": {
        "responses": {
          "200": {
            "description": "Profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "accessToken": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/users": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Users"
          }
        }
      }
    }
  }
}